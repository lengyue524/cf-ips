# 复制为青龙环境变量，或在脚本同目录创建 .env 文件

# ========== CFST 测速 ==========
# 固定版本如 v2.3.5；留空则始终使用 latest
CFST_VERSION=

# IATA 地区码，逗号分隔，如 HKG,LAX,SEA；留空不限地区
CFST_COLO=

# 单次模式输出标签（可选），如 HK / SG / US / JP / EU
CFST_REGION_TAG=

# 优选 IP 数量（默认 10）
CFST_IP_COUNT=10

# 通用分区域配置（推荐）：标签:地区码列表:数量；多个用 ; 分隔
# 例：HK:HKG:10;SG:SIN:10;US:LAX,SEA,SJC:10;JP:NRT,HND,KIX:10
CFST_REGION_PLAN=

# 是否启用下载测速：true / false
CFST_ENABLE_DOWNLOAD=true

# 测速端口（默认 443）
CFST_PORT=443

# 下载测速地址，留空使用 CFST 默认
CFST_DOWNLOAD_URL=

# 输出文件名（仓库内相对路径）
CFST_OUTPUT_FILE=cf_ips.txt

# ========== GitHub 同步 ==========
# 仓库 SSH 地址或 user/repo 简写
GITHUB_REPO=git@github.com:your-user/cf-ips.git

# 分支（默认 main）
GITHUB_BRANCH=main

# GitHub 生成的 SSH 私钥完整内容（含 BEGIN/END 行）
GITHUB_SSH_KEY=

# ========== 可选 ==========
# 脚本工作目录，留空则使用脚本所在目录
CFST_WORK_DIR=
