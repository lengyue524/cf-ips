# 复制为青龙环境变量，或在脚本同目录创建 .env 文件

# ========== CFST 测速 ==========
# 固定版本如 v2.3.5；留空则始终使用 latest
CFST_VERSION=

# IATA 地区码，逗号分隔，如 HKG,LAX,SEA；留空不限地区
CFST_COLO=

# 优选 IP 数量（默认 10）
CFST_IP_COUNT=10

# 分地区配额（>0 时启用；启用后会覆盖 CFST_COLO/CFST_IP_COUNT 单次模式）
# 香港
CFST_HK_COUNT=0
CFST_HK_CODES=HKG
# 新加坡
CFST_SG_COUNT=0
CFST_SG_CODES=SIN
# 美国（可自行调整为你偏好的节点）
CFST_US_COUNT=0
CFST_US_CODES=LAX,SEA,SJC
# 日本
CFST_JP_COUNT=0
CFST_JP_CODES=NRT,HND,KIX

# 是否启用下载测速：true / false
CFST_ENABLE_DOWNLOAD=true

# 下载测速地址，留空使用 CFST 默认
CFST_DOWNLOAD_URL=

# 输出文件名（仓库内相对路径）
CFST_OUTPUT_FILE=cf_ips.txt

# ========== GitHub 同步 ==========
# 仓库 SSH 地址或 user/repo 简写
GITHUB_REPO=git@github.com:your-user/cf-ips.git

# 分支（默认 main）
GITHUB_BRANCH=main

# GitHub 生成的 SSH 私钥完整内容（含 BEGIN/END 行）
GITHUB_SSH_KEY=

# ========== 可选 ==========
# 脚本工作目录，留空则使用脚本所在目录
CFST_WORK_DIR=
